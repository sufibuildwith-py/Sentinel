# Set to true to run the frontend without a live backend.
# Use this for Vercel-only deployments before Railway is ready.
NEXT_PUBLIC_USE_FIXTURES=true

# The base URL of the deployed Spring Boot backend.
# Leave empty when NEXT_PUBLIC_USE_FIXTURES is true.
# For the live Vercel console, set this to the Railway HTTPS domain and redeploy.
NEXT_PUBLIC_SENTINEL_API_URL=
