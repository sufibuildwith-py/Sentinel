{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel.local/schema/evaluation-scenario-v1.json",
  "title": "Sentinel Phase 9 labelled evaluation scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenarioId", "category", "paymentEvents", "incidentExpected",
    "expectedRootCauseCategory", "eligibleStrategies", "expectedPolicyDecision",
    "approvalRequired", "expectedExecutionBehavior", "expectedProviderOutcome",
    "expectedFinancialMutationMinor", "expectedAuditEvents"
  ],
  "properties": {
    "scenarioId": { "type": "string", "pattern": "^eval_[a-z0-9_]+_[0-9]{3}$" },
    "category": { "type": "string" },
    "paymentEvents": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "incidentExpected": { "type": "boolean" },
    "expectedRootCauseCategory": { "type": "string" },
    "eligibleStrategies": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "expectedPolicyDecision": { "type": ["string", "null"], "enum": ["AUTO", "HUMAN", "DENY", null] },
    "approvalRequired": { "type": "boolean" },
    "expectedExecutionBehavior": { "type": "string" },
    "expectedProviderOutcome": { "type": "string" },
    "expectedFinancialMutationMinor": { "type": "integer", "minimum": 0 },
    "expectedAuditEvents": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
