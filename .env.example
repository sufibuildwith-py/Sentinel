# Runtime profile and Railway-assigned HTTP port.
SPRING_PROFILES_ACTIVE=local
PORT=8080

# Local/Compose Gemini key. Create it in Google AI Studio.
GEMINI_API_KEY=replace_with_your_gemini_api_key
# Production profile binding for the same Gemini credential.
LLM_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_CONNECT_TIMEOUT=5s
GEMINI_REQUEST_TIMEOUT=30s

# Optional Razorpay Test Mode execution. Leave disabled for the deterministic evaluation demo.
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_BASE_URL=https://api.razorpay.com

# Railway PostgreSQL variables used by the prod profile.
DATABASE_URL=jdbc:postgresql://localhost:5432/sentinel
DB_USERNAME=sentinel
DB_PASSWORD=replace_with_a_strong_database_password

# Comma-separated browser origins allowed to call /api/v1/**.
# Railway production allows the deployed Vercel app plus local development.
CORS_ALLOWED_ORIGINS=https://sentinelxops.vercel.app,http://localhost:3000

# Per-client-IP limits for expensive mutation endpoints.
RATE_LIMIT_DEMO_PER_MINUTE=10
RATE_LIMIT_EXECUTION_PER_MINUTE=5
RATE_LIMIT_EVALUATION_PER_MINUTE=3

# Railway deploy health-check deadline. PORT is injected by Railway automatically.
RAILWAY_HEALTHCHECK_TIMEOUT_SEC=60

# Swagger is enabled locally and forcibly disabled by the prod profile.
SWAGGER_ENABLED=true

# Local Compose database. Change the password if the database is exposed beyond localhost.
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_local_only
